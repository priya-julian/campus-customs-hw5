      "tool_output": {
        "found": true,
        "sku": "CC-TEE-WHITE",
        "name": "Classic Bulldog Tee",
        "size": "S",
        "qty": 0,
        "location": "Aisle B",
        "in_stock": false,
        "sizes_on_hand": [
          {
            "size": "L",
            "qty": 3
          },
          {
            "size": "M",
            "qty": 5
