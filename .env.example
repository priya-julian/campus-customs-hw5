# Copy this file to .env and fill in your own key:
#     cp .env.example .env
#
# The real .env is git-ignored and must never be committed.

# Portkey API key — every agent call is routed through Portkey.
PORTKEY_API_KEY=your_portkey_api_key_here

# Optional. Defaults to https://api.portkey.ai/v1 if unset.
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
